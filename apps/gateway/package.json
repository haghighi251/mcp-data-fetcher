{
  "name": "@repo/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Express API gateway: validates Global Query payloads and routes them to the BFF.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"(configure eslint)\" && exit 0",
    "test": "echo \"(configure vitest)\" && exit 0"
  },
  "dependencies": {
    "@repo/data-core": "workspace:*",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
