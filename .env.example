# --- Redis (hot-path cache, lives on customer infrastructure) ---
REDIS_URL=redis://localhost:6379
CACHE_PREFIX=dcore
CACHE_DEFAULT_TTL_MS=5000

# --- MCP query-planning server (Node.js, customer-hosted) ---
# How the data-core query engine reaches the MCP server.
# transport=stdio spawns the server as a child process; transport=inprocess
# runs the planner in the same process (good for local dev / tests).
MCP_TRANSPORT=inprocess
MCP_SERVER_COMMAND=node
MCP_SERVER_ARGS=packages/data-core/dist/mcp/server.js

# --- Databases (optional; enable the adapters you actually use) ---
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/app
MONGO_URL=mongodb://localhost:27017
MONGO_DB=app

# --- Service wiring ---
BFF_PORT=4000
BFF_URL=http://localhost:4000
GATEWAY_PORT=8080
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080
